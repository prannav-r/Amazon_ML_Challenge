# ==============================================================================
# Git Ignore Configuration
# Amazon ML Challenge 2026: Business Entity Resolution
# ==============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Python Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Large Datasets & Raw Resources ---
# Do not track gigabyte-scale challenge datasets or downloaded resource bundle
student_resource/
dataset/
**/dataset/
*.tsv
*.csv
*.parquet
*.feather
*.h5
*.hdf5

# --- Archives & Compressed Packages ---
*.zip
*.tar.gz
*.tar
*.gz
*.7z
*.rar
submission/
submissions/
*_submission/
*_submission.zip

# --- Embedded Databases & Temporary Storage ---
*.duckdb
*.duckdb.wal
*.duckdb.tmp*
*.db
*.sqlite
*.sqlite3

# --- Model Checkpoints & Serialized Artifacts ---
models/
checkpoints/
*.pkl
*.pickle
*.joblib
*.bin
*.pt
*.pth
*.onnx
*.model
*.lgb
*.xgb
!output/frozen_model_c1.pkl

# --- Submission Outputs & Logs ---
output/*
!output/.gitkeep
!output/frozen_model_c1.pkl
*.log
logs/

# --- Temporary & Scratch Files ---
scratch/
temp/
tmp/
*.tmp
*.bak

# --- Jupyter Notebooks & Profiling ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Testing & Code Quality Tools ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE & OS Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
